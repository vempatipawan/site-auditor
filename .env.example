# Site auditor keys. ALL OPTIONAL, ALL FREE. Copy to .env (git-ignored) and fill in only what you have.
# With no key, the module that needs it reports "skipped" and the audit still finishes. Never commit .env.

# Unlocks: 35-crux (real-visitor Core Web Vitals + 25-week history), 36-psi (Lighthouse), Safe Browsing in 51-exposure.
# Get it: console.cloud.google.com -> new project -> APIs & Services -> enable "Chrome UX Report API",
# "PageSpeed Insights API", "Safe Browsing API" -> Credentials -> Create API key. No card needed.
GOOGLE_API_KEY=

# Unlocks: 500 Globalping tests per hour instead of 250 (37-globalping works without it).
# Get it: dash.globalping.io -> sign in with GitHub -> Tokens.
GLOBALPING_TOKEN=

# Unlocks: blacklist status across vendors in 51-exposure.
# Get it: virustotal.com -> free account -> profile -> API key.
VIRUSTOTAL_API_KEY=

# Reserved for later modules (PRD section 13). Not read by any module yet.
# Cloudflare Radar URL Scanner: Cloudflare dashboard -> My Profile -> API Tokens -> custom -> Account / URL Scanner / Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Google results from the client's country: serper.dev, 2,500 free searches, no card.
SERPER_API_KEY=
# UK company registry lookups: developer.company-information.service.gov.uk
COMPANIES_HOUSE_KEY=
